# -----------------------------------------------------------------------------
# HTTP → HTTPS (+ ACME challenge)
# -----------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name
        opms.medicaent.in
        app.medicaent.in
        users.medicaent.in
        plans.medicaent.in
        leads.medicaent.in
        expense.medicaent.in
        api.medicaent.in
        auth.medicaent.in
        api-products.medicaent.in
        api-parties.medicaent.in
        api-plans.medicaent.in
        api-leads.medicaent.in
        api-expense.medicaent.in;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# =============================================================================
# Frontends
# =============================================================================

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name app.medicaent.in;
    include /etc/nginx/snippets/medica-ssl.conf;
    client_max_body_size 50m;

    location / {
        include /etc/nginx/snippets/proxy-upgrade.conf;
        proxy_pass http://medica_app_frontend;
    }
}

