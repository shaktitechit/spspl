server {
    listen 80;
    server_name app.medicaent.in;
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location / {
        include /etc/nginx/snippets/proxy-upgrade.conf;
        proxy_pass http://medica_app_frontend;
    }
}

