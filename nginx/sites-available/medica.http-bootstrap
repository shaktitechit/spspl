# =============================================================================
# Medica — HTTP-only bootstrap (use BEFORE certificates exist)
#
#   sudo cp nginx/snippets/* /etc/nginx/snippets/
#   sudo cp nginx/sites-available/medica.http-bootstrap /etc/nginx/sites-available/medica
#   sudo ln -sfn /etc/nginx/sites-available/medica /etc/nginx/sites-enabled/medica
#   sudo mkdir -p /var/www/html
#   sudo nginx -t && sudo systemctl reload nginx
#
# Issue certs (DNS must already point here):
#   sudo certbot certonly --webroot -w /var/www/html \
#     -d opms.medicaent.in -d app.medicaent.in -d users.medicaent.in -d plans.medicaent.in \
#     -d leads.medicaent.in -d expense.medicaent.in -d api.medicaent.in -d auth.medicaent.in \
#     -d api-products.medicaent.in -d api-parties.medicaent.in -d api-plans.medicaent.in \
#     -d api-leads.medicaent.in -d api-expense.medicaent.in \
#     --cert-name opms.medicaent.in
#
# Then switch to HTTPS:
#   sudo cp nginx/sites-available/medica /etc/nginx/sites-available/medica
#   sudo nginx -t && sudo systemctl reload nginx
# =============================================================================

upstream medica_opms_backend {
    server 100.75.219.4:5001;
    # server 127.0.0.1:5001 backup;
    keepalive 32;
}
upstream medica_opms_frontend {
    server 100.75.219.4:5002;
    # server 127.0.0.1:5002 backup;
    keepalive 16;
}
